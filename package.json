{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "build": "cross-env INIT_CWD=$PWD next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir pages --dir app --dir components --dir lib --dir layouts --dir scripts",
    "prepare": "husky",
    "images:metadata": "node scripts/generate-image-metadata.mjs",
    "images:download": "./scripts/download-images.sh",
    "speaking:extract-mvp": "node scripts/extract-mvp-speaking.mjs",
    "speaking:fetch": "node scripts/fetch-sessionize-data.mjs",
    "speaking:merge": "node scripts/merge-speaking-data-v2.mjs",
    "speaking:youtube-sync": "node scripts/sync-youtube-talks.mjs",
    "speaking:build": "npm run speaking:extract-mvp && npm run speaking:fetch && npm run speaking:merge",
    "pushup:update": "node scripts/update-pushup-challenge.mjs",
    "pushup:fundraising": "node scripts/scrape-fundraising.mjs",
    "ui:review": "node scripts/ui-review-loop.mjs",
    "e2e": "playwright test",
    "e2e:screenshots": "playwright test --update-snapshots",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test": "yarn test:unit && yarn e2e",
    "audit:ai": "node scripts/audit/ai-benchmark.mjs",
    "audit:links": "node scripts/audit/link-check.mjs",
    "audit:a11y": "yarn exec pa11y-ci -c .pa11yci.js -j",
    "audit:lighthouse": "node scripts/audit/lighthouse.mjs",
    "test:seo": "yarn audit:ai && yarn audit:links && yarn audit:a11y"
  },
  "dependencies": {
    "@headlessui/react": "2.2.9",
    "@next/bundle-analyzer": "15.5.18",
    "@plaiceholder/next": "^3.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "body-scroll-lock": "^4.0.0-beta.0",
    "contentlayer2": "0.5.8",
    "esbuild": "0.25.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "image-size": "2.0.2",
    "next": "15.5.18",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "plaiceholder": "^3.0.0",
    "pliny": "0.4.1",
    "postcss": "^8.5.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^1.3.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
