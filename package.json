    "launch-editor": "^2.14.1",
    "esbuild": "^0.28.1",
    "minimatch@^9.0.0": "^9.0.7",
    "minimatch@^9.0.4": "^9.0.7",
    "minimatch@^10.1.2": "^10.2.3",
    "minimatch@^10.2.2": "^10.2.3",
    "lodash": "^4.18.0",
    "lodash-es": "^4.18.0",
    "qs": "^6.15.2",
    "uuid@^9.0.1": "^11.1.1",
    "follow-redirects": "^1.16.0",
