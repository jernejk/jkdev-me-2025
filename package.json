    "@svgr/webpack": "^8.1.0",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@unlighthouse/cli": "^0.17.7",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.18",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "linkinator": "^7.6.1",
    "lint-staged": "^13.3.0",
    "pa11y-ci": "^4.1.0",
    "playwright": "^1.59.0",
    "prettier": "^3.8.1",
