    "svgo": "^3.3.3",
    "js-yaml@^3.13.1": "^3.14.2",
    "js-yaml@^4.1.0": "^4.2.0",
    "js-yaml@^4.1.1": "^4.2.0",
    "js-yaml@4.1.0": "^4.2.0",
    "mdast-util-to-hast": "^13.2.1",
    "unhead": "^2.1.13",
    "estree-util-value-to-estree": "^3.3.3",
    "postcss": "^8.5.10",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "@babel/helpers": "^7.26.10",
    "ip-address": "^10.1.1",
